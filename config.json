{
  "video_name": "trial_2",
  "paths": {
    "input_dir": "Input_Videos",
    "output_dir": "Output_Videos",
    "tmp_dir": "tmp"
  },
  "prompts": {
    "person": {
      "short": "p",
      "threshold": 0.3,
      "mask_threshold": 0.4
    },
    "violin": {
      "short": "v",
      "threshold": 0.3,
      "mask_threshold": 0.3
    },
    "violin_bow": {
      "short": "vb",
      "threshold": 0.3,
      "mask_threshold": 0.3
    }
  },
  "postprocess": {
    "fill_small_holes": {
      "max_hole_area": 30
    },
    "opening": {
      "kernel_size": 2,
      "iterations": 1
    },
    "erosion": {
      "kernel_size": 3,
      "iterations": 1
    },
    "smooth_gaussian": {
      "sigma": 2
    }
  },
  "cleanup": {
    "delete_tmp_after_run": false
  }
}